{"info":{"_postman_id":"bijou-ai-whatsapp-api","name":"Bijou AI WhatsApp Enterprise","description":"Bijou AI WhatsApp Enterprise API\n\n**Quick Start:**\n1. Import this collection into Postman\n2. Create an environment with variables:\n   - `base_url`: https://bijou-staging.fly.dev\n   - `api_key`: Your WhatsApp bridge API key\n   - `dashboard_token`: Your dashboard auth token\n   - `tenant_id`: Your tenant UUID\n3. Start testing endpoints!\n\n**Version:** 2.2.0\n**Documentation:** https://bijou-staging.fly.dev/api-docs","version":"2.2.0","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},"item":[{"name":"Authentication","item":[{"name":"Google Login","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/auth/google/login","host":["{{base_url}}"],"path":["api","auth","google","login"],"query":[]},"description":"Step 1: Redirect user to Google OAuth consent screen\n\nUsage: User clicks \"Sign in with Google\" → hits this endpoint → redirected to Google"},"response":[]},{"name":"Google Callback","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/auth/google/callback","host":["{{base_url}}"],"path":["api","auth","google","callback"],"query":[{"key":"code","value":"","description":"","disabled":false},{"key":"state","value":"","description":"","disabled":false}]},"description":"Step 2: Google redirects here with authorization code\nExchange code for tokens → fetch user info → create tenant → redirect to QR onboarding"},"response":[]}],"description":"Endpoints for authentication"},{"name":"Dashboard API","item":[{"name":"Get Dashboard Stats","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/stats","host":["{{base_url}}"],"path":["api","dashboard","stats"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Get dashboard statistics scoped by tenant"},"response":[]},{"name":"Get Active Conversations","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/conversations","host":["{{base_url}}"],"path":["api","dashboard","conversations"],"query":[{"key":"limit","value":"","description":"","disabled":true},{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Get list of active conversations for tenant (with fallback to messages table)"},"response":[]},{"name":"Get Conversation Detail","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/conversation/{customer_jid}","host":["{{base_url}}"],"path":["api","dashboard","conversation","{customer_jid}"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Get detailed message history for a specific customer (with fallback to messages table)"},"response":[]},{"name":"Takeover Conversation","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/takeover","host":["{{base_url}}"],"path":["api","dashboard","takeover"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Switch conversation to human agent mode","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Return To Ai","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/return-to-ai/{customer_jid}","host":["{{base_url}}"],"path":["api","dashboard","return-to-ai","{customer_jid}"],"query":[{"key":"agent_name","value":"","description":"","disabled":false},{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Return control to the AI agent"},"response":[]},{"name":"Send Message As Agent","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/send-message","host":["{{base_url}}"],"path":["api","dashboard","send-message"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Send message to customer via WhatsApp bridge","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Add Knowledge","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/knowledge","host":["{{base_url}}"],"path":["api","dashboard","knowledge"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Add training data / context for the AI agent","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Get Escalations","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/escalations","host":["{{base_url}}"],"path":["api","dashboard","escalations"],"query":[{"key":"status","value":"","description":"","disabled":true},{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"List escalations for the tenant (optionally filtered by status)"},"response":[]},{"name":"Claim Escalation","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/escalations/{escalation_id}/claim","host":["{{base_url}}"],"path":["api","dashboard","escalations","{escalation_id}","claim"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Agent claims a ticket"},"response":[]},{"name":"Resolve Escalation","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/escalations/{escalation_id}/resolve","host":["{{base_url}}"],"path":["api","dashboard","escalations","{escalation_id}","resolve"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Resolve a ticket"},"response":[]},{"name":"Get Whatsapp Qr","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/whatsapp/qr","host":["{{base_url}}"],"path":["api","dashboard","whatsapp","qr"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Get linking QR code from the bridge using device mapping"},"response":[]},{"name":"Init Whatsapp","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/whatsapp/init","host":["{{base_url}}"],"path":["api","dashboard","whatsapp","init"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Initialize session in bridge for this tenant"},"response":[]},{"name":"Get Whatsapp Status","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/whatsapp/status","host":["{{base_url}}"],"path":["api","dashboard","whatsapp","status"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Strict status check for this tenant's WhatsApp connection"},"response":[]},{"name":"Get Google Auth Url","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/google/auth-url","host":["{{base_url}}"],"path":["api","dashboard","google","auth-url"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Start Google OAuth flow"},"response":[]},{"name":"Google Callback","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/google/callback","host":["{{base_url}}"],"path":["api","dashboard","google","callback"],"query":[{"key":"code","value":"","description":"","disabled":false},{"key":"state","value":"","description":"","disabled":false}]},"description":"Callback for Google OAuth - state is tenant_id"},"response":[]},{"name":"Get Agents","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/agents","host":["{{base_url}}"],"path":["api","dashboard","agents"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":""},"response":[]},{"name":"Create Agent","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/agents","host":["{{base_url}}"],"path":["api","dashboard","agents"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Delete Agent","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{dashboard_token}}","description":"Dashboard authentication token"}],"url":{"raw":"{{base_url}}/api/dashboard/agents/{agent_id}","host":["{{base_url}}"],"path":["api","dashboard","agents","{agent_id}"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":""},"response":[]}],"description":"Endpoints for dashboard api"},{"name":"Knowledge Base API","item":[{"name":"Upload Knowledge Document","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/knowledge/upload","host":["{{base_url}}"],"path":["api","knowledge","upload"],"query":[]},"description":"Upload a knowledge document for a tenant.\n\nSupported formats: PDF, DOCX, TXT, MD, CSV, JSON\n\nHeaders:\n    X-Tenant-ID: Tenant UUID\n\nReturns:\n    UploadResponse with document details"},"response":[]},{"name":"List Knowledge Documents","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/knowledge/list","host":["{{base_url}}"],"path":["api","knowledge","list"],"query":[]},"description":"List all knowledge documents for a tenant.\n\nHeaders:\n    X-Tenant-ID: Tenant UUID\n\nReturns:\n    DocumentListResponse with list of documents"},"response":[]},{"name":"Delete Knowledge Document","request":{"method":"DELETE","header":[],"url":{"raw":"{{base_url}}/api/knowledge/{document_id}","host":["{{base_url}}"],"path":["api","knowledge","{document_id}"],"query":[]},"description":"Delete a knowledge document.\n\nPath Parameters:\n    document_id: Document UUID\n\nHeaders:\n    X-Tenant-ID: Tenant UUID\n\nReturns:\n    DeleteResponse with success status"},"response":[]},{"name":"Get Combined Knowledge","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/knowledge/combined","host":["{{base_url}}"],"path":["api","knowledge","combined"],"query":[]},"description":"Get combined knowledge text from all documents for a tenant.\n\nThis is used to inject knowledge into the AI's context.\n\nHeaders:\n    X-Tenant-ID: Tenant UUID\n\nReturns:\n    CombinedKnowledgeResponse with combined text"},"response":[]},{"name":"Knowledge Api Health","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/knowledge/health","host":["{{base_url}}"],"path":["api","knowledge","health"],"query":[]},"description":"Health check for knowledge API"},"response":[]}],"description":"Endpoints for knowledge base api"},{"name":"Onboarding API","item":[{"name":"Signup Property Agent","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/onboarding/signup","host":["{{base_url}}"],"path":["api","onboarding","signup"],"query":[]},"description":"Step 1: Create new tenant and initiate WhatsApp session\n\nReturns onboarding URL with token for QR display page","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Get Onboarding Status","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/onboarding/status/{token}","host":["{{base_url}}"],"path":["api","onboarding","status","{token}"],"query":[]},"description":"Step 2: Check WhatsApp connection status\n\nCalled by onboarding page every 3 seconds to detect when QR is scanned"},"response":[]},{"name":"Get Qr Code","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/onboarding/qr/{token}","host":["{{base_url}}"],"path":["api","onboarding","qr","{token}"],"query":[]},"description":"Step 3: Proxy QR code image from WhatsApp bridge\n\nReturns PNG image that updates when tenant_id changes"},"response":[]},{"name":"Complete Onboarding","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/onboarding/complete/{token}","host":["{{base_url}}"],"path":["api","onboarding","complete","{token}"],"query":[]},"description":"Step 4: Mark onboarding as complete\n\nCalled when WhatsApp connection is confirmed"},"response":[]},{"name":"Onboarding Health","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/onboarding/health","host":["{{base_url}}"],"path":["api","onboarding","health"],"query":[]},"description":"Check if onboarding API and dependencies are working"},"response":[]}],"description":"Endpoints for onboarding api"},{"name":"Other Endpoints","item":[{"name":"Get Status","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/proactive/status","host":["{{base_url}}"],"path":["api","proactive","status"],"query":[]},"description":"Get proactive messaging system status"},"response":[]},{"name":"Schedule Message","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/proactive/schedule","host":["{{base_url}}"],"path":["api","proactive","schedule"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Schedule a message to be sent later.\n\nExample:\n```json\n{\n  \"recipient\": \"60123456789@s.whatsapp.net\",\n  \"message_type\": \"lead_followup\",\n  \"content\": \"Hi! Just following up on your inquiry...\",\n  \"delay_minutes\": 1440\n}\n```","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Create Campaign","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/proactive/campaign","host":["{{base_url}}"],"path":["api","proactive","campaign"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Create a new marketing campaign.\n\nExample:\n```json\n{\n  \"name\": \"New Year Promo\",\n  \"message_template\": \"Happy New Year! Get 20% off...\",\n  \"target_segment\": \"all\",\n  \"scheduled_time\": \"2026-01-01T00:00:00Z\"\n}\n```","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Set Silence Rule","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/proactive/silence-rule","host":["{{base_url}}"],"path":["api","proactive","silence-rule"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Set up silence detection and auto-reengagement.\n\nExample:\n```json\n{\n  \"silence_days\": 7,\n  \"message_template\": \"We haven't heard from you in a while! How can we help?\"\n}\n```","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"List Campaigns","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/proactive/campaigns","host":["{{base_url}}"],"path":["api","proactive","campaigns"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"List all campaigns for the authenticated tenant"},"response":[]},{"name":"List Scheduled Messages","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/proactive/scheduled","host":["{{base_url}}"],"path":["api","proactive","scheduled"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"List all scheduled messages for the authenticated tenant"},"response":[]},{"name":"Cancel Scheduled Message","request":{"method":"DELETE","header":[],"url":{"raw":"{{base_url}}/api/proactive/scheduled/{message_id}","host":["{{base_url}}"],"path":["api","proactive","scheduled","{message_id}"],"query":[{"key":"tenant_id","value":"","description":"","disabled":true},{"key":"token","value":"","description":"","disabled":true}]},"description":"Cancel a scheduled message (only if owned by authenticated tenant)"},"response":[]},{"name":"External Webhook","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-API-Key","value":"{{api_key}}","description":"WhatsApp bridge API key"}],"url":{"raw":"{{base_url}}/api/webhook","host":["{{base_url}}"],"path":["api","webhook"],"query":[]},"description":"Handle external webhooks (e.g., from Forms, Landing Pages).\nRoutes data through ToolOrchestrator for lead capture."},"response":[]},{"name":"Serve Onboarding","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/onboard/{token}","host":["{{base_url}}"],"path":["onboard","{token}"],"query":[]},"description":"Serve onboarding page for property agent signup"},"response":[]},{"name":"Update Testing Mode","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/settings/testing-mode","host":["{{base_url}}"],"path":["api","settings","testing-mode"],"query":[]},"description":"Toggle testing mode and set test numbers.\n\nWhen testing mode is enabled, Bijou will ONLY reply to numbers in test_numbers list.\nThis protects production users during testing.\n\nHeaders:\n    X-Tenant-ID: Tenant UUID\n\nBody:\n    testing_mode: true/false\n    test_numbers: Array of phone numbers (e.g., [\"+60143856929\"])\n\nReturns:\n    TestingModeResponse with updated settings","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Update Ignore List","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/settings/ignore-list","host":["{{base_url}}"],"path":["api","settings","ignore-list"],"query":[]},"description":"Update ignore/private number lists.\n\nNumbers in these lists will NEVER receive auto-replies from Bijou.\nUse this to exclude owner's personal number, test numbers, or VIP contacts.\n\nHeaders:\n    X-Tenant-ID: Tenant UUID\n\nBody:\n    ignore_numbers: Array of numbers to ignore\n    private_numbers: Array of private numbers (alias for ignore)\n\nReturns:\n    IgnoreListResponse with updated lists","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Update Business Hours","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/settings/business-hours","host":["{{base_url}}"],"path":["api","settings","business-hours"],"query":[]},"description":"Update business hours configuration.\n\nWhen enabled, Bijou will only auto-reply during specified business hours.\nOutside hours, a custom out-of-hours message is sent (if provided).\n\nHeaders:\n    X-Tenant-ID: Tenant UUID\n\nBody:\n    enabled: true/false\n    timezone: Timezone string (e.g., \"Asia/Kuala_Lumpur\")\n    schedule: Object with daily schedules\n    out_of_hours_message: Custom message for outside hours\n\nReturns:\n    BusinessHoursResponse with updated configuration","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Update Auto Reply","request":{"method":"PUT","header":[{"key":"Content-Type","value":"application/json"}],"url":{"raw":"{{base_url}}/api/settings/auto-reply","host":["{{base_url}}"],"path":["api","settings","auto-reply"],"query":[]},"description":"Toggle auto-reply and set welcome message.\n\nWhen auto-reply is disabled, Bijou will NOT respond to any messages.\nUse this to temporarily pause the AI assistant.\n\nHeaders:\n    X-Tenant-ID: Tenant UUID\n\nBody:\n    auto_reply_enabled: true/false\n    welcome_message: Optional custom welcome message\n\nReturns:\n    AutoReplyResponse with updated settings","body":{"mode":"raw","raw":"{}","options":{"raw":{"language":"json"}}}},"response":[]},{"name":"Settings Api Health","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api/settings/health","host":["{{base_url}}"],"path":["api","settings","health"],"query":[]},"description":"Health check for settings API"},"response":[]}],"description":"Endpoints for other endpoints"},{"name":"System & Documentation","item":[{"name":"Root","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/","host":["{{base_url}}"],"path":[],"query":[]},"description":"Serve the dashboard homepage"},"response":[]},{"name":"Api Documentation","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/api-docs","host":["{{base_url}}"],"path":["api-docs"],"query":[]},"description":"Serve interactive API documentation"},"response":[]},{"name":"Changelog","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/changelog","host":["{{base_url}}"],"path":["changelog"],"query":[]},"description":"Serve API changelog with version history"},"response":[]},{"name":"Health Check","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/health","host":["{{base_url}}"],"path":["health"],"query":[]},"description":"Health check endpoint for Fly.io"},"response":[]},{"name":"Status","request":{"method":"GET","header":[],"url":{"raw":"{{base_url}}/status","host":["{{base_url}}"],"path":["status"],"query":[]},"description":"Detailed status endpoint"},"response":[]}],"description":"Endpoints for system & documentation"},{"name":"Webhooks","item":[{"name":"Webhook Message","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-API-Key","value":"{{api_key}}","description":"WhatsApp bridge API key"}],"url":{"raw":"{{base_url}}/webhook/message","host":["{{base_url}}"],"path":["webhook","message"],"query":[]},"description":"Webhook endpoint for receiving new messages from GOWA bridge (v8.x format).\nExpects: {\"event\": \"message\", \"device_id\": \"xxx\", \"payload\": {...}}\n\nPERFORMANCE OPTIMIZATION:\n- Responds to bridge in <100ms (prevents timeouts)\n- Processes message in background task (12-20s processing time)\n- No duplicate processing (idempotency via message_id)"},"response":[]},{"name":"Webhook Connection Status","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-API-Key","value":"{{api_key}}","description":"WhatsApp bridge API key"}],"url":{"raw":"{{base_url}}/webhook/connection","host":["{{base_url}}"],"path":["webhook","connection"],"query":[]},"description":"Webhook for WhatsApp connection status updates from bridge.\nAuto-updates tenant with whatsapp_jid when session connects.\n\nExpected payload:\n{\n    \"tenant_id\": \"uuid\",\n    \"whatsapp_jid\": \"+60123456789@s.whatsapp.net\",\n    \"status\": \"connected\" | \"disconnected\",\n    \"timestamp\": \"ISO 8601\"\n}"},"response":[]},{"name":"Webhook Telegram","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"},{"key":"X-API-Key","value":"{{api_key}}","description":"WhatsApp bridge API key"}],"url":{"raw":"{{base_url}}/webhook/telegram","host":["{{base_url}}"],"path":["webhook","telegram"],"query":[]},"description":"Webhook endpoint for receiving Telegram updates.\nConverts Telegram Update to UnifiedMessage and processes via BijouAI."},"response":[]}],"description":"Endpoints for webhooks"}],"variable":[{"key":"base_url","value":"https://bijou-staging.fly.dev","type":"string"},{"key":"api_key","value":"","type":"string","description":"WhatsApp bridge API key (get from .env file)"},{"key":"dashboard_token","value":"","type":"string","description":"Dashboard authentication token (JWT from login)"},{"key":"tenant_id","value":"","type":"string","description":"Your tenant UUID"}]}