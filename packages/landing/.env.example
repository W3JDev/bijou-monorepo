# Bijou AI — Marketing Site Environment Variables
# =================================================
# Copy this file to .env (or .env.local) and fill in the values.
#
# SECURITY NOTES (2026-07-25):
#   - VITE_-prefixed vars are SHIPPED TO THE BROWSER. Do NOT name
#     server-side secrets with that prefix. See lib/env.js logTypoWarning.
#   - .env is git-ignored. The real values live in Vercel project env.
#   - The per-domain Resend/ImprovMX keys below belong to the
#     production backend (w3j-bijou-ai-main), NOT this marketing repo.
#     They appear in this repo's .env only because the founder's local
#     dev setup shares one env file across both repos.

# ---- Vercel-public site URL ---------------------------------------------
# Injected into the client bundle at build time via vite.config.ts.
VITE_PUBLIC_SITE_URL=https://mybijou.xyz

# ---- Cal.com (public, client-safe) -------------------------------------
# The username slug for the public Cal.com booking page.
VITE_PUBLIC_CAL_USERNAME=getbijou

# ---- Supabase (server-side ONLY, do not use VITE_ prefix) ---------------
# Service-role key bypasses RLS. Never expose to the client.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service-role-jwt...
SUPABASE_SERVICE_ROLE_KEY=eyJ...same-key-or-rotate...

# ---- Email (Resend) ----------------------------------------------------
RESEND_API_KEY=re_xxx
EMAIL_FROM=Bijou AI <hello@mybijou.xyz>
EMAIL_NOTIFY=founder@mybijou.xyz

# ---- AI gateway (chat.js proxy) ----------------------------------------
# Set these on Vercel env. The keys are the LLM provider keys used
# when the public AI gateway (sprites.dev) is unreachable.
CUSTOME_API_KEY=sk-xxx
CUSTOM_API_ENDPOINT=https://ai-gateway-xxx.sprites.app/v1
# Optional: comma-separated model fallbacks used by api/chat.js
# AI_GATEWAY_MODELS=auto/best-fast,antigravity/gemini-2.5-flash,cc/claude-haiku-4-5

# ---- Founder WhatsApp notification JID ---------------------------------
# Used by api/send.js (founder-only relay). Default: 60174106981@s.whatsapp.net
# FOUNDER_JID=60174106981@s.whatsapp.net

# ---- Internal shared secret (api/send.js + create-link edge fn) --------
# 32+ random bytes. Generate: `openssl rand -hex 32`
INTERNAL_API_TOKEN=replace-me-with-32-random-bytes

# ---- Stripe (api/spots.js reads) ---------------------------------------
# Only used for the "early adopter spots remaining" counter. If absent,
# the endpoint returns a hardcoded fallback (current behaviour).
# STRIPE_SECRET_KEY=sk_test_xxx

# ---- PostHog (https://us.posthog.com) -----------------------------------
# Frontend project key — VITE_ prefix means it IS shipped to the browser,
# which is the normal PostHog pattern. The personal API key is server-only
# and stays secret.
#
# Find these in PostHog: Settings → Project → Project details.
# - Project Key is "phc_..."  (public, browser-safe)
# - Personal API Key is "phx_..." (server-only, has full org access)
# - Host: https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU)
VITE_POSTHOG_PROJECT_KEY=phc_replace_me
VITE_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_KEY=phc_replace_me
POSTHOG_HOST=https://us.i.posthog.com
# Set to 0 to force-disable server-side PostHog capture (kill switch).
# POSTHOG_ENABLED=1
# Personal API key — used for any PostHog admin API calls (warehouse
# exports, etc.). Optional for this project; only set if you need it.
# POSTHOG_PERSONAL_API_KEY=phx_replace_me

# ---- Upstash Redis (optional, recommended for production) --------------
# Setup:
#   1. Create a free account at https://upstash.com
#   2. Create a Redis database (free tier: 10k req/day, 256 MB)
#   3. Copy the REST URL and REST Token from the database dashboard
#   4. Add BOTH vars below to Vercel env (Settings → Environment Variables)
# Until these are set, rate limiting falls back to an in-process LRU
# that resets per Vercel cold start. See lib/rateLimit.js.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# ---- Per-domain Resend keys (BACKEND repo, not this one) ---------------
# These are referenced by w3j-bijou-ai-main. They live in this .env
# only because the local dev setup shares the file. Do not commit.
# RESEND_<DOMAIN>_KEY=re_xxx
# RESEND_<DOMAIN>_DOMAIN=mybijou.xyz
# RESEND_<DOMAIN>_SEND_EMAILS=true

# ---- Per-domain ImprovMX keys (BACKEND repo, not this one) -------------
# Used for inbound email routing on the production backend. Same caveat
# as the per-domain Resend keys above.
# IMPROVMX_<DOMAIN>_KEY=xxx
# IMPROVMX_<DOMAIN>_DOMAIN=mybijou.xyz
# IMPROVMX_<DOMAIN>_RECEIVE_EMAILS=true

# ---- Vercel-deploy-only secrets (do NOT add to local .env) -------------
# These are set ONLY in Vercel env, never on a dev machine:
#   - BIJOU_PRODUCTION_URL (replaces hard-coded bijou-production.fly.dev)
#   - BIJOU_STAGING_URL    (replaces hard-coded bijou-staging.fly.dev)
#   - VERCEL_OIDC_ID / VERCEL_OIDC_TOKEN (CI/CD only)
