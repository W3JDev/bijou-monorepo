# Environment contract for the Dokploy deployment. Values are REDACTED —
# paste this into the Dokploy service's Environment tab and fill it in there.
# Never commit real values; the repo's pre-commit hook will try to stop you and
# it should not have to.
#
# Legend
#   [REQUIRED]  the stack refuses to start without it (`:?` in the compose)
#   [OPTIONAL]  absent = that feature stays off; the app still runs
#   [DO NOT SET] setting it actively breaks something. Explained inline.
#
# The backend reads ~190 distinct env vars. This file covers everything
# required plus every optional var that gates a shipped feature.
#
# IMPORTANT: a var reaches a container ONLY if docker-compose.dokploy.yml lists
# it under that service's `environment:`. Adding a line here that the compose
# does not forward does nothing. The remaining vars are internal tuning knobs with safe in-code
# defaults; `grep -rhoE 'os\.getenv\("[A-Z_]+"' packages/backend/src | sort -u`
# is the full list.

# ─────────────────────────────── Identity ──────────────────────────────────
# [REQUIRED] The canonical public origin of the backend. Every user-facing URL
# (magic links, OAuth redirects, dashboard links) is built from this.
PUBLIC_URL=https://app.mybijou.xyz

# [REQUIRED] Hostname Traefik routes to this service. Usually PUBLIC_URL's host.
BACKEND_DOMAIN=app.mybijou.xyz

# [OPTIONAL] Only if you serve the marketing site from Dokploy rather than
# Vercel. Enable with `--profile landing`.
LANDING_DOMAIN=

# [OPTIONAL] Only with `--profile voice`.
VOICE_DOMAIN=

# ─── [DO NOT SET] — the canonical-domain trap ──────────────────────────────
# Each of these is read BEFORE the PUBLIC_URL-derived fallback, so a stale
# value silently wins and users get bounced to the wrong origin. The dashboard
# keeps its JWT in origin-scoped localStorage, so a cross-origin redirect
# destroys the session and the user loops back to login.
#
# This has bitten the project twice (2026-08-10 and 2026-08-23). Leaving them
# unset is the correct configuration — the code's own fallbacks are right.
#
#   LOGIN_URL              -> src/saas/auth_api.py:848
#   APP_URL                -> pricing_engine / reporting_engine / trial_manager
#   DASHBOARD_URL          -> escalation_notifier / stripe_service
#   GOOGLE_REDIRECT_URI    -> src/saas/google_oauth.py
#
# GOOGLE_REDIRECT_URI additionally needs
# https://app.mybijou.xyz/api/auth/google/callback registered in the Google
# Cloud Console OAuth client, or Google rejects with redirect_uri_mismatch.

# ─────────────────────────────── Database ──────────────────────────────────
# [REQUIRED] Supabase project URL, e.g. https://<ref>.supabase.co
SUPABASE_URL=

# [REQUIRED] service-role key. Server-side only. It bypasses RLS entirely.
# Never expose it to a browser.
SUPABASE_SERVICE_KEY=

# [REQUIRED — but the compose pins it, do not override to anything else]
# DB_TYPE decides where BijouAI persists. src/core/bijou.py:2035 branches
# _init_supabase() vs _init_sqlite() on it, and the default when unset is
# "sqlite" — which writes to /data/bijou.db inside the container while the
# dashboard reads Supabase. Split brain, and the data is gone on redeploy.
DB_TYPE=supabase

# NOTE: the compose maps SUPABASE_KEY to the same value automatically.
# 15 call sites read SUPABASE_KEY with no default (e.g. nango_api.py:35) and
# would otherwise fail at first use rather than at startup.

# ───────────────────────────────── AI ──────────────────────────────────────
# All LLM traffic goes through the ai:// aliases in
# packages/backend/llm_gateway.yaml. A provider with no key is skipped.
#
# [REQUIRED] MiniMax (OpenAI-compatible, https://api.minimax.io/v1). The only
# live AI key as of 2026-09-26. Serves ai://fast, reasoning, extract, helpdesk
# and vision via fallback.
MINIMAX_API_KEY=

# [OPTIONAL] OpenAI. The ONLY non-Gemini provider allowed for ai://private
# (strict privacy). Without it, ai://private calls fail with
# NoProviderAvailable.
OPENAI_API_KEY=

# [OPTIONAL] Extra standard-privacy fallbacks.
OPENROUTER_API_KEY=
AI_GATEWAY_API_KEY=

# [LEAVE EMPTY] Gemini. All Gemini keys were revoked 2026-09-26. Not required;
# the gateway skips Gemini when this is empty. Note: image upload (bijou.py
# genai.Client) and ~13 modules still call the Gemini SDK directly and will
# degrade until migrated.
GEMINI_API_KEY=

# ─────────────────────────────── Secrets ───────────────────────────────────
# [REQUIRED by the compose — any fresh random value works] Gates every /api/admin/* endpoint via the X-Admin-Key header.
# Admin scope includes: view all tenants, impersonate users, issue refunds,
# apply migrations. A previous value was committed to git on 2026-08-10 and
# scrubbed on 2026-08-24 — see docs/SECURITY_ALERT_2026-08-24_admin_key.md.
# Generate fresh: openssl rand -hex 32
ADMIN_API_KEY=

# [REQUIRED] Signs the public /data-request tokens (GDPR/PDPA subject access).
# Read with no default at src/core/data_request_api.py:57.
# Generate fresh: openssl rand -hex 32
DATA_REQUEST_SIGNING_KEY=

# [REQUIRED] Shared secret for the bridge -> backend /webhook/* calls. The
# compose passes it to GOWA as --webhook-secret (GOWA then signs each body:
# X-Hub-Signature-256: sha256=<hmac>) and to the backend, which verifies that
# signature (_verify_webhook_secret, src/core/bijou.py). One value, set once
# here, reaches both containers. Mismatch = every inbound message 401s.
# Generate fresh: openssl rand -hex 32
BIJOU_WEBHOOK_SECRET=

# ─────────────────────────────── Bridge ────────────────────────────────────
# [REQUIRED] Basic-auth credentials for the GOWA bridge. The backend sends
# these as Basic auth (get_bridge_auth_headers, onboarding_api.py:176) and GOWA
# enforces them via --basic-auth. Same values both sides.
# Generate the password fresh: openssl rand -hex 24
BRIDGE_USER=bijou
BRIDGE_PASSWORD=
# BRIDGE_PASSWORD must be URL-safe (hex is): the bridge healthcheck embeds it
# in http://user:pass@127.0.0.1:3000/devices.
#
# NOTE: the bridge is the GOWA image, configured entirely by command flags in
# the compose (--webhook, --webhook-secret, --basic-auth, --db-uri). The old
# packages/bridge vars (DEFAULT_TENANT_ID, ENABLE_HISTORY_SYNC,
# BIJOU_WEBHOOK_URL, DB_PATH) are not read by GOWA — do not set them.

# ────────────────────────────── Payments ───────────────────────────────────
# Routes (src/saas/payment_api.py, mounted by src/core/bijou.py):
#   POST /api/payment/checkout   creates a Checkout session (auth required)
#   POST /api/payment/portal     Stripe customer portal (auth required)
#   POST /api/payment/webhook    Stripe -> backend. Verified with
#                                stripe.Webhook.construct_event against
#                                STRIPE_WEBHOOK_SECRET; rejects all if unset.
# Stripe Dashboard -> Developers -> Webhooks endpoint URL must be
#   https://app.mybijou.xyz/api/payment/webhook
# and STRIPE_WEBHOOK_SECRET is THAT endpoint's signing secret (whsec_...).
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_failed
#
# [REQUIRED] sk_live_... (or sk_test_... for a test-mode rehearsal).
STRIPE_SECRET_KEY=
# [REQUIRED] whsec_... of the endpoint above.
STRIPE_WEBHOOK_SECRET=
# [REQUIRED] price_... ids of the PRO plan, same mode (live/test) as the key.
# Unset = hardcoded fallback ids in payment_api.py of unknown mode.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# [OPTIONAL] GROWTH is contact-sales today (no checkout), used only to map
# subscription.updated events back to a plan.
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
# [OPTIONAL] Not needed for checkout (Stripe-hosted page); shown on the admin keys page.
STRIPE_PUBLISHABLE_KEY=

# ──────────────────────────────── Email ────────────────────────────────────
# [OPTIONAL] Magic links and notifications. Without a provider, signup
# confirmation emails are never delivered — users cannot complete signup,
# because GoTrue runs with mailer_autoconfirm=false.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
FROM_NAME=

# ───────────────────────────── Integrations ────────────────────────────────
# [OPTIONAL] Google OAuth (Gmail/Calendar tools).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [OPTIONAL] Nango — the integrations backend that replaced the unlaunched
# Composio scaffold. Setting either key mounts /api/nango/*.
# Not yet verified against the real Nango API (unit-tested with mocks only).
NANGO_SECRET_KEY=
NANGO_HOST=

# [OPTIONAL] Cal.com booking.
CALCOM_CLIENT_ID=
CALCOM_CLIENT_SECRET=

# [OPTIONAL] Telegram channel.
TELEGRAM_BOT_TOKEN=

# [OPTIONAL] Voice concierge (--profile voice).
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=
TELNYX_WEBHOOK_SECRET=

# [DO NOT SET] The Composio scaffold was never launched and was superseded by
# Nango. The compose pins ENABLE_COMPOSIO=false.
#   ENABLE_COMPOSIO

# ──────────────────────────── Observability ────────────────────────────────
# [OPTIONAL] Langfuse LLM tracing. Run Langfuse as a SEPARATE Dokploy service —
# do not give it the Supabase service-role key.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# [OPTIONAL] INFO in production. DEBUG logs request bodies.
LOG_LEVEL=INFO

# ────────────────────────────── Resources ──────────────────────────────────
# [OPTIONAL] Tuning. Each uvicorn worker imports the whole app and constructs
# its own BijouAI instance. Keep workers x footprint under the limit.
WEB_CONCURRENCY=2
BACKEND_MEM_LIMIT=2G
BRIDGE_MEM_LIMIT=512M

# [OPTIONAL] Pin a specific build. Defaults to `latest`, which makes rollback
# ambiguous — set it to the git SHA in real deployments.
IMAGE_TAG=latest
