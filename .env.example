# =============================================================================
# BIJOU AI — MASTER .env.example
# =============================================================================
# This file documents every env var the monorepo uses, grouped by package.
# It is the SINGLE SOURCE OF TRUTH for which env var goes where.
# Real .env files are gitignored. Copy this to .env (or per-package .env) and
# fill in values. DO NOT commit real values.
#
# Namespace target: every new var should be BIJOU_* to avoid collisions
# with other projects in the same shell (Bold Connect, etc.).
# Legacy vars (no prefix) are still read by existing code — see roadmap below.
# =============================================================================


# -----------------------------------------------------------------------------
# packages/landing/  (Vercel — VITE_* vars are public, others are server-only)
# -----------------------------------------------------------------------------
# Client-side (must have VITE_ prefix — exposed to bundle)
VITE_PUBLIC_SITE_URL=https://mybijou.xyz

# Server-side (Vercel serverless api/*.js) — NEVER use VITE_ prefix
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_NOTIFY=
FOUNDER_EMAIL=
STRIPE_SECRET_KEY=
INTERNAL_API_TOKEN=

# AI gateway (OmniRoute) + direct Gemini fallback
CUSTOM_API_ENDPOINT=
CUSTOM_API_KEY=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# PostHog (analytics — set in Vercel + Supabase webhook)
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://us.i.posthog.com

# Composite.io (Spam check)
COMPOSIO_API_KEY=


# -----------------------------------------------------------------------------
# packages/backend/  (Fly.io — bijou-production)
# -----------------------------------------------------------------------------
# Database
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
DATABASE_URL=                    # Fly.io internal — set via `fly secrets set`

# AI gateway (lead pipeline) — same gateway as landing
CUSTOM_API_ENDPOINT=
CUSTOM_API_KEY=
MINIMAX_API_KEY=
MINIMAX_API_ENDPOINT=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OMNIROUTE_API_KEY=

# Payment (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_NOTIFY=
FOUNDER_EMAIL=

# Bridge inter-service auth
BRIDGE_SHARED_SECRET=


# -----------------------------------------------------------------------------
# packages/bridge/  (Fly.io — per-tenant)
# -----------------------------------------------------------------------------
# WhatsApp Web session persistence (stored in packages/bridge/store/*.db)
BRIDGE_STORE_PATH=/data/store
BRIDGE_HTTP_PORT=8080

# Backend auth
BACKEND_URL=https://bijou-production.fly.dev
BACKEND_API_TOKEN=

# WhatsApp Web multi-account (per-tenant)
TENANT_ID=


# -----------------------------------------------------------------------------
# CI/CD & deploy tooling
# -----------------------------------------------------------------------------
# Vercel
BIJOU_VERCEL_TOKEN=
BIJOU_VERCEL_ORG_ID=
BIJOU_VERCEL_PROJECT_ID=

# Fly.io
BIJOU_FLY_API_TOKEN=
BIJOU_FLY_APP_BACKEND=bijou-production
BIJOU_FLY_APP_BRIDGE=bijou-bridge

# GitHub
BIJOU_GITHUB_TOKEN=
BIJOU_GITHUB_REPO=W3J-Dev/bijou-monorepo

# Monitoring
BIJOU_HEALTHCHECK_URL=https://app.mybijou.xyz/health
BIJOU_BETTERSTACK_TOKEN=          # optional, for prod uptime monitoring


# -----------------------------------------------------------------------------
# Lead-pipeline cron (run on local machine or Contabo VPS)
# -----------------------------------------------------------------------------
# These are read by the .cjs scripts in packages/backend/app/
# They come from packages/backend/.env (copied from this template)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AI_GATEWAY_URL=https://ai-gateway-bufxd.sprites.app/v1
AI_GATEWAY_KEY=


# =============================================================================
# NAMESPACE ROADMAP
# =============================================================================
# Goal: every var in this repo should be BIJOU_* (no collisions with Bold
# Connect, Bijou staging, etc. when running in the same shell).
#
# Existing code reads legacy names (no prefix). Migration plan:
#   Phase 1 (now): legacy names work. This file is the spec.
#   Phase 2 (Q4): Add BIJOU_* aliases, fall back to legacy.
#   Phase 3 (Q1): Cut over to BIJOU_* only, remove legacy.
#
# For NEW scripts (CI, deploy, agent team): use BIJOU_* from day 1.
# For EXISTING code: leave as-is, don't break prod. The agent team's job
# (bijou-devops) is to migrate one package at a time, behind a flag.
